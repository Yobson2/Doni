# Build context for doni-backend/Dockerfile and doni-frontend/Dockerfile,
# both built from the repository root.

# Installed and built inside the image
**/node_modules
**/dist

# Secrets and local settings
**/.env
**/.env.*
!**/.env.example

# Not needed to build either image
.git
.github
.claude
docs
**/coverage
doni-backend/test
doni-frontend/test-results
doni-frontend/playwright-report
doni-frontend/.lighthouseci
**/*.log
