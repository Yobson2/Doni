{
  "openapi": "3.0.0",
  "paths": {
    "/api/users/me": {
      "get": {
        "operationId": "getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Read my account",
        "tags": [
          "Users"
        ]
      },
      "patch": {
        "operationId": "updateMe",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Update my account",
        "tags": [
          "Users"
        ]
      }
    },
    "/api/users": {
      "get": {
        "operationId": "listUsers",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "Admin role required"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "List accounts (admin)",
        "tags": [
          "Users"
        ]
      }
    },
    "/api/users/{id}": {
      "get": {
        "operationId": "getUser",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "Admin role required"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Read an account (admin)",
        "tags": [
          "Users"
        ]
      },
      "patch": {
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "Admin role required"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Update an account (admin)",
        "tags": [
          "Users"
        ]
      },
      "delete": {
        "operationId": "deactivateUser",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account deactivated"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "Admin role required"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Deactivate an account (admin)",
        "tags": [
          "Users"
        ]
      }
    },
    "/api/auth/sign-up": {
      "post": {
        "operationId": "signUp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created and signed in; sets the refresh cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Email already has an account"
          }
        },
        "summary": "Create an account",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/sign-in": {
      "post": {
        "operationId": "signIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in; sets the refresh cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password"
          }
        },
        "summary": "Sign in",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": "New access token; the refresh cookie is rotated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "No valid session"
          }
        },
        "security": [
          {
            "doni_refresh": []
          }
        ],
        "summary": "Exchange the refresh cookie for a new access token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "operationId": "signOut",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Signed out"
          }
        },
        "security": [
          {
            "doni_refresh": []
          }
        ],
        "summary": "End the session and clear the refresh cookie",
        "tags": [
          "Auth"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Health check: database and job runner status",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "Doni API",
    "description": "BRVM investment research and portfolio tracking",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Sign-up, sign-in, session refresh and sign-out"
    },
    {
      "name": "Users",
      "description": "Own account, and account administration (admin)"
    },
    {
      "name": "Health",
      "description": "Health check"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token from sign-in, sign-up or refresh"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "doni_refresh",
        "description": "httpOnly refresh-token cookie, set by the API"
      }
    },
    "schemas": {
      "UserRole": {
        "type": "string",
        "enum": [
          "ADMIN",
          "CHEF_ZONE",
          "MEMBRE"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "example": "Awa"
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "example": "Traoré"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "role",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Awa"
          },
          "lastName": {
            "type": "string",
            "example": "Traoré"
          }
        }
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ]
      },
      "UserListResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserResponseDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Awa"
          },
          "lastName": {
            "type": "string",
            "example": "Traoré"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "SignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "StrongP@ss1",
            "minLength": 8,
            "maxLength": 72
          },
          "firstName": {
            "type": "string",
            "example": "Awa"
          },
          "lastName": {
            "type": "string",
            "example": "Traoré"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived bearer token; keep in memory"
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "StrongP@ss1"
          }
        },
        "required": [
          "email",
          "password"
        ]
      }
    }
  }
}
