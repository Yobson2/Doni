  "info": {
    "title": "Doni API",
    "description": "BRVM investment research and portfolio tracking",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Sign-up, sign-in, session refresh and sign-out"
    },
    {
      "name": "Users",
      "description": "Own account, and account administration (admin)"
    },
    {
      "name": "Catalogue",
      "description": "Securities, sectors, indices and end-of-day prices (changes: admin)"
    },
    {
      "name": "Health",
      "description": "Health check"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token from sign-in, sign-up or refresh"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "doni_refresh",
        "description": "httpOnly refresh-token cookie, set by the API"
      }
    },
    "schemas": {
      "UserRole": {
        "type": "string",
        "enum": [
          "ADMIN",
          "CHEF_ZONE",
          "MEMBRE"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "example": "Awa"
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "example": "Traoré"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "role",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Awa"
          },
          "lastName": {
            "type": "string",
            "example": "Traoré"
          }
        }
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
