# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=app_db

# SSL for managed databases (staging/production)
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_CA_CERT=
# DB_POOL_SIZE=5

# =============================================================================
# JWT Authentication
# =============================================================================
# Required, and must differ from each other. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# =============================================================================
# Job runner (pg-boss, stored in the database above)
# =============================================================================
# JOBS_POOL_SIZE=4
# How often schedules are checked (pg-boss defaults: 30 and 5 seconds)
# JOBS_CRON_MONITOR_INTERVAL_SECONDS=30
# JOBS_CRON_WORKER_INTERVAL_SECONDS=5

# =============================================================================
# Daily BOC ingestion
# =============================================================================
# Cron (Africa/Abidjan) of the daily ingestion; "off" to not schedule it.
# BOC_INGESTION_CRON=30 18,21 * * 1-5
# Where the BRVM publishes its bulletins (defaults shown)
# BOC_LISTING_URL=https://www.brvm.org/fr/bulletins-officiels-de-la-cote
# BOC_FILES_URL=https://www.brvm.org/sites/default/files

# =============================================================================
# Historical price backfill (ADR 0018)
# =============================================================================
# Backfilled BOC history stays hidden from users until the BRVM's
# redistribution terms cover historical data (ADR 0003). Set to true only
# once that licence gate is cleared.
HISTORY_PUBLIC=false

# =============================================================================
# Mail (SMTP)
# =============================================================================
# Local mail catcher from docker-compose (Mailpit, UI on http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM="App Team" <noreply@example.com>

# =============================================================================
# Docker
# =============================================================================
RUNNING_IN_DOCKER=false
